# ==============================================================================
# SLUGA AGENT — КОНФИГУРАЦИЯ ОКРУЖЕНИЯ (.env)
# ==============================================================================

# --- ОСНОВНАЯ БАЗА: LiteAI (https://liteai.tech/) ---
# Быстрый доступ к Claude 3.5 Sonnet, GPT-4o, DeepSeek в РФ без VPN
LITEAI_API_KEY=your_liteai_api_key_here
LITEAI_BASE_URL=https://api.liteai.tech/v1
LITEAI_MODEL=claude-3-5-sonnet-20241022

# --- РЕЗЕРВНАЯ БАЗА: Google AI Studio (Gemini) через Cloudflare Worker ---
# Получить бесплатный ключ: https://aistudio.google.com/
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_api_key_here
# Эндпоинт твоего Cloudflare Worker (с суффиксом /v1beta/openai/)
CF_GEMINI_PROXY_URL=https://hermes-proxy.johnngoan66101996.workers.dev/v1beta/openai/
GOOGLE_GEMINI_MODEL=gemini-3.7-flash

# --- TELEGRAM БОТ (Интерфейс OpenClaw) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Если сервер в РФ, используй Cloudflare Worker прокси для Telegram:
# https://hermes-proxy.johnngoan66101996.workers.dev/
TELEGRAM_PROXY_URL=https://hermes-proxy.johnngoan66101996.workers.dev/
# Список ID пользователей в Telegram через запятую, имеющих доступ к агенту:
TELEGRAM_ALLOWED_USERS=123456789,987654321

# --- СИСТЕМНЫЕ НАСТРОЙКИ ХИРУРГА ---
# Путь к базе SQLite
SQLITE_DB_PATH=./data/sluga_memory.db
# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Максимальное количество шагов ReAct петли (Hermes loop)
MAX_REACT_STEPS=12
# Режим автоисправления (Actor-Critic Self-Healing): true/false
AUTO_HEALING_ENABLED=true
